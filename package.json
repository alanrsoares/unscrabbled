    "vitest": "^4.1.11",
    "zx": "^8.8.5"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.48",
    "clsx": "^2.1.1",
    "ky": "^2.1.0",
    "lucide-svelte": "^1.0.1",
